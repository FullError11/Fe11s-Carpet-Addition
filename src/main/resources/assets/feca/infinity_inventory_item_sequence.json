{
    "override": true,
    "groups": {
        "wood_parts": {
            "input": [ "namespace", "id" ],
            "output": [
                "${namespace}:${id}_planks",
                "${namespace}:${id}_stairs",
                "${namespace}:${id}_slab",
                "${namespace}:${id}_fence",
                "${namespace}:${id}_fence_gate",
                "${namespace}:${id}_door",
                "${namespace}:${id}_trapdoor",
                "${namespace}:${id}_pressure_plate",
                "${namespace}:${id}_button"
            ]
        },
        "wood": {
            "input": [ "namespace", "id" ],
            "output": [
                "${namespace}:${id}_log",
                "${namespace}:${id}_wood",
                "${namespace}:stripped_${id}_log",
                "${namespace}:stripped_${id}_wood",
                { "wood_parts": [ "${namespace}", "${id}" ] }
            ]
        },
        "nether_wood": {
            "input": [ "namespace", "id" ],
            "output": [
                "${namespace}:${id}_stem",
                "${namespace}:${id}_hyphae",
                "${namespace}:stripped_${id}_stem",
                "${namespace}:stripped_${id}_hyphae",
                { "wood_parts": [ "${namespace}", "${id}" ] }
            ]
        },
        "stone_parts": {
            "input": [ "namespace", "id" ],
            "output": [
                "${namespace}:${id}",
                "${namespace}:${id}_stairs",
                "${namespace}:${id}_slab",
                "${namespace}:${id}_wall"
            ]
        },
        "stone_parts_no_wall": {
            "input": [ "namespace", "id" ],
            "output": [
                "${namespace}:${id}",
                "${namespace}:${id}_stairs",
                "${namespace}:${id}_slab"
            ]
        },
        "brick_parts": {
            "input": [ "namespace", "base", "prefix" ],
            "output": [
                "${namespace}:${base}",
                "${namespace}:${prefix}_stairs",
                "${namespace}:${prefix}_slab",
                "${namespace}:${prefix}_wall"
            ]
        },
        "brick_parts_no_wall": {
            "input": [ "namespace", "base", "prefix" ],
            "output": [
                "${namespace}:${base}",
                "${namespace}:${prefix}_stairs",
                "${namespace}:${prefix}_slab"
            ]
        }
    },
